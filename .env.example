# ==============================================================================
# VARIABLES DE ENTORNO PARA RENDER (WEB SERVICE)
# ==============================================================================
# En Render, PORT lo asigna la plataforma automáticamente (no es necesario definirlo manualmente)
PORT=10000
KM_RAM_DIAS=60

# ⚡ SUPABASE (Requerido: Base de datos y REST)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_o_service_key

# 🐘 POSTGRESQL NATIVO (Requerido: Pooler transaccional para RAM Dirty-Check y baja latencia)
DATABASE_URL=postgresql://postgres.tu-proyecto:tu_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
PG_MAX_CONNECTIONS=5
PG_IDLE_TIMEOUT=10000

# 🔑 GOOGLE SERVICE ACCOUNT (Opcional en Render si las novedades o proxy leen Google Sheets)
GOOGLE_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-fbsvc@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_private_key_aqui\n-----END PRIVATE KEY-----\n"

